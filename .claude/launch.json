{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "floc-web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "floc-web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "docs",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "docs",
        "-p",
        "4000",
        "--no-clipboard"
      ],
      "port": 4000
    },
    {
      "name": "wireframes",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "floc/wireframe",
        "-p",
        "4100",
        "--no-clipboard"
      ],
      "port": 4100
    }
  ]
}
