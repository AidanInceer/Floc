{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "floc-web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "floc-web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "floc-metro",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "floc-mobile",
        "exec",
        "expo",
        "start",
        "--dev-client"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "docs",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/docs-server.mjs"
      ],
      "port": 4173
    },
    {
      "name": "wireframes",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/wireframe-server.mjs"
      ],
      "port": 4100
    }
  ]
}
