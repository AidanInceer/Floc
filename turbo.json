{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["FLOC_NODE_VERSION"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["FLOC_NEXT_DIST_DIR", "FLOC_VERIFY_BUILD"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".next-verify/**", "!.next-verify/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^transit"]
    },
    "test": {
      "dependsOn": ["^build", "^transit"],
      "outputs": ["coverage/**"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "env": ["FLOC_NEXT_DIST_DIR"],
      "passThroughEnv": ["CI"],
      "cache": false
    },
    "fitness": {
      "dependsOn": ["build"],
      "env": ["FLOC_NEXT_DIST_DIR"]
    },
    "fitness:source": {
      "dependsOn": ["^transit"]
    }
  }
}
