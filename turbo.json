{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["FLOC_NEXT_DIST_DIR"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".next-verify/**", "!.next-verify/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "env": ["FLOC_NEXT_DIST_DIR"],
      "passThroughEnv": ["CI"],
      "cache": false
    },
    "fitness": {
      "dependsOn": ["build"],
      "env": ["FLOC_NEXT_DIST_DIR"]
    }
  }
}
