{
  "name": "floc",
  "version": "0.0.0",
  "private": true,
  "description": "Floc: group trip planning. Web, phone, shared packages and marketing in one workspace.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "run:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run.ps1",
    "run:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "fitness": "pnpm fitness:repo && turbo run fitness",
    "fitness:repo": "node scripts/checks/repo.mjs",
    "files:check": "node --test scripts/check-files-map.test.mjs && node scripts/check-files-map.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "design:check": "node --test scripts/design/rules.test.mjs && node scripts/design/check.mjs",
    "docs:dev": "node scripts/docs-server.mjs",
    "wireframe": "node scripts/wireframe-server.mjs",
    "wireframe:tags": "node scripts/wireframe-tags.mjs",
    "wireframe:shoot": "node scripts/wireframe/kit/shoot.mjs",
    "comments": "node scripts/check-comments.mjs --working",
    "marketing": "node floc/marketing/src/cli.ts",
    "explore:new": "node scripts/new-explore-trip.mjs",
    "parity": "node --experimental-strip-types scripts/parity/run.mjs",
    "verify": "node scripts/checks/run.mjs release",
    "sonar": "npx --yes sonar-scanner",
    "plugins:sync": "node scripts/sync-floc-plugin.mjs",
    "plugins:check": "node --test scripts/sync-floc-plugin.test.mjs && node scripts/sync-floc-plugin.mjs --check",
    "hooks:install": "node scripts/workspace/hooks.mjs install",
    "prepare": "node scripts/sync-floc-plugin.mjs",
    "quality:check": "node scripts/quality/run.mjs",
    "quality:test": "node --test scripts/quality/*.test.mjs",
    "checks": "node scripts/checks/run.mjs",
    "checks:test": "node scripts/checks/tool-tests.mjs",
    "delivery": "node scripts/delivery.mjs",
    "workspace:prepare": "node scripts/workspace.mjs prepare",
    "workspace:status": "node scripts/workspace.mjs status",
    "workspace:list": "node scripts/workspace.mjs list",
    "workspace:start": "node scripts/workspace.mjs start",
    "delivery:policy": "node scripts/delivery/policy.mjs",
    "plugins:refresh": "node scripts/sync-floc-plugin.mjs --refresh --force",
    "workspace:new": "node scripts/workspace.mjs new",
    "workspace:sweep": "node scripts/workspace.mjs sweep",
    "workspace:finish": "node scripts/workspace.mjs finish"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/sync-floc-plugin.mjs --check && pnpm exec lint-staged",
    "commit-msg": "node scripts/check-commit-msg.mjs $1"
  },
  "devDependencies": {
    "lint-staged": "^17.5.1",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "eslint": "9.39.5",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "typescript-eslint": "8.70.0"
  }
}
