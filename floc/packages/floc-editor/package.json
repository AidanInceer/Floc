{
  "name": "@floc/editor",
  "version": "0.1.0",
  "private": true,
  "description": "The notes page editor (#408): Floc's own UI on the headless Tiptap core, kept live by Yjs. The web app renders it; the phone runs it as an Expo DOM component.",
  "type": "module",
  "exports": {
    "./editor.css": "./src/editor.css",
    "./view/*": "./src/view/*.tsx",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@floc/core": "workspace:*",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-collaboration-caret": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "y-protocols": "^1.0.7",
    "yjs": "13.6.32"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "happy-dom": "^20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
