{
  "name": "@floc/globe",
  "version": "0.1.0",
  "private": true,
  "description": "The paper globe (#468): sphere maths, the country outlines, and the travel globe on a profile. The web app renders it; the phone runs it as an Expo DOM component.",
  "type": "module",
  "exports": {
    "./travel-globe.css": "./src/view/travel-globe.css",
    "./view/*": "./src/view/*.tsx",
    "./canvas/*": "./src/canvas/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@floc/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
