{
  "name": "@floc/api",
  "version": "0.1.0",
  "private": true,
  "description": "The Floc tRPC API — the one contract every client reads a trip through. Pure: it declares procedures and validates input, and reaches data only through the port the host implements.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@floc/core": "workspace:*",
    "@trpc/server": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
