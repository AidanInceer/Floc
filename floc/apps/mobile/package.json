{
  "name": "floc-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Floc for iOS and Android — one Expo codebase, reading the same trips through @floc/api as the web app.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "maestro": "maestro test .maestro"
  },
  "dependencies": {
