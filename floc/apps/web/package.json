{
  "name": "floc-web",
  "version": "0.131.7",
  "private": true,
  "description": "Floc v1 — group travel planner. Next.js App Router + Turso (libSQL) + Drizzle + Better Auth.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "clean:next": "node scripts/clean-next.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "fitness": "pnpm deps:check && pnpm dead-code && pnpm check:tokens && pnpm check:css && pnpm check:contrast && pnpm check:bundle",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "dead-code": "knip",
    "check:tokens": "node --experimental-strip-types scripts/check-tokens.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:contrast": "node --experimental-strip-types scripts/check-contrast.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --experimental-strip-types --import ./scripts/alias-loader-register.mjs --env-file=.env src/db/seed/index.ts",
    "db:reset": "node --experimental-strip-types --import ./scripts/alias-loader-register.mjs --env-file=.env src/db/seed/index.ts --fresh",
    "auth:generate": "better-auth generate"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@better-auth/expo": "~1.6.30",
    "@blocknote/ariakit": "^0.54.0",
    "@blocknote/core": "^0.54.0",
    "@blocknote/react": "^0.54.0",
    "@floc/api": "workspace:*",
    "@floc/core": "workspace:*",
    "@libsql/client": "^0.14.0",
    "@trpc/server": "^11.0.0",
    "better-auth": "~1.6.30",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.0.2",
    "leaflet": "^1.9.4",
    "next": "^15.5.25",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^4.0.0",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "knip": "^6.32.2",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
