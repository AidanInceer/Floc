#e6e4de"><tr><td class="m-pad" style="padding:32px 28px"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 24px"><tr><td><span class="fg-ink" style="font-family:'Red Hat Display','Trebuchet MS',system-ui,sans-serif;font-weight:800;font-size:18px;line-height:1;letter-spacing:-0.02em;color:#14141a">floc<span class="fg-pen" style="color:#4e68d8">.</span></span></td><td align="right" class="fg-ink-2" style="font-family:'Red Hat Mono','Cascadia Mono',Consolas,'Courier New',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:#63636f">Sun 15 Nov 2026</td></tr></table><h1 class="fg-ink" style="font-family:'Red Hat Display','Trebuchet MS',system-ui,sans-serif;font-weight:800;font-size:25px;line-height:1.2;margin:0 0 16px;color:#14141a">Choose a new password</h1><p class="fg-ink" style="font-family:'Red Hat Text',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:15px;line-height:1.55;margin:0 0 12px;color:#14141a">Someone asked to reset the password on this address.</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0 8px"><tr><td class="bg-pen" style="border-radius:8px;padding:0 18px;background-color:#4e68d8"><a href="https://floc.live/reset-password?token=sample" class="fg-sheet" style="font-family:'Red Hat Text',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:15px;font-weight:600;line-height:40px;display:inline-block;text-decoration:none;border-radius:8px;color:#ffffff">Choose a new password</a></td></tr></table><p class="fg-ink-2" style="font-family:'Red Hat Text',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:13px;line-height:1.5;margin:0 0 4px;color:#63636f">The link works once and expires within the hour. If this wasn&#39;t you, ignore it — nothing has changed.</p></td></tr></table><div class="m-foot" style="padding:16px 28px 0"><p class="fg-ink-2" style="font-family:'Red Hat Text',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:13px;line-height:1.5;margin:0 0 8px;color:#63636f">You got this because a password reset was asked for on this address.</p><p class="fg-ink-2" style="font-family:'Red Hat Mono','Cascadia Mono',Consolas,'Courier New',monospace;font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:0.06em;margin:0;color:#63636f">Floc · floc.live</p></div></div><!--[if mso]></td></tr></table><![endif]--></body></html>"`;

exports[`the 'Reset password' email > writes the same text as before 1`] = `
