# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.next-verify/
out/
.turbo/
*.tsbuildinfo

# Env & secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# DB
*.sqlite
*.sqlite3
prisma/*.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
.nyc_output/

# Personal source data (keep private financial workbooks out of git)
*.xlsx

# Claude Code — only machine-local files ignored; skills + launch.json are shared
.claude/settings.local.json
.claude/plugins/

.scratch/

human-*.md
**/backlog/*
!**/backlog/*.html
.agents/
**/mockups/
# Product docs stay local — the repo may go public.
docs/
# Shared docs runtime assets are source code and must be committed.
!docs/
!docs/assets/
!docs/assets/**
docs/*.html
docs/**/*.html
docs/*.md
docs/**/*.md
# Private docs — stack accounts, credential inventories. Never committed.
docs/private/

# Firebase config for Android push (#345). On EAS it comes from the GOOGLE_SERVICES_JSON file variable.
floc/apps/mobile/google-services.json

# Prototypes: local only, served on :4100 by scripts/wireframe-server.mjs.
floc/wireframe/
