  "webOnly": [
    {
      "id": "files",
      "path": "floc/apps/web/src/app/trip/[id]/files",
      "status": "planned",
      "why": "The app lists, uploads, re-files and removes. What is still web-only is opening one: the bytes come off a route handler behind a session cookie, and a phone has no viewer for a PDF yet."
    },
    {
      "id": "signup",
      "path": "floc/apps/web/src/app/signup",
      "status": "wontfix",
      "why": "Account creation, password reset and email verification stay in the browser — the app signs in only, so there is one place credentials are handled."
    }
