# finance-planner venture environment — copy to .env and fill in. NEVER commit real values.

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus

# --- Auth / security ---
AUTH_SESSION_SECRET=change-me-long-random
# Key used to encrypt open-banking access tokens at rest (32-byte base64)
TOKEN_ENCRYPTION_KEY=change-me-base64-32-bytes
TOTP_ISSUER=FinancePlanner

# --- Open banking provider (UK) ---
# One of: gocardless | truelayer  (abstracted behind the open-banking module)
OPEN_BANKING_PROVIDER=gocardless
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
OPEN_BANKING_REDIRECT_URI=http://localhost:3000/connect/callback

# --- AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Knowledge base ---
# Where UK gov reference data (tax bands, NI, allowances) is cached
KNOWLEDGE_BASE_REFRESH_CRON=0 3 * * 1
