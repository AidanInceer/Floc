{
  "name": "waypoint-web",
  "version": "0.47.0",
  "private": true,
  "description": "Waypoint v1 — group travel planner. Next.js App Router + Turso (libSQL) + Drizzle + Better Auth.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "fitness": "pnpm deps:check && pnpm dead-code && pnpm check:css && pnpm check:contrast && pnpm check:bundle",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "dead-code": "knip",
    "check:css": "node scripts/check-css.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --experimental-strip-types --import ./scripts/alias-loader-register.mjs --env-file=.env src/db/seed.ts",
    "auth:generate": "better-auth generate"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "^15.1.0",
    "knip": "^6.32.2",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
