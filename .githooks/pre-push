#!/usr/bin/env bash
#
# Gate the push on everything CI is about to check anyway (scripts/verify.sh).
#
# WHY pre-push, NOT pre-commit: CI fires on push, so push is the moment the
# answer matters. Commits stay free, which keeps a work-in-progress commit
# cheap — and this repo lands one commit per ticket at session end, so the two
# hook points are seconds apart in practice.
#
# WHY .githooks/ AND NOT .git/hooks/: .git/hooks is not versioned, so a hook
# left there disappears on a fresh clone and is invisible to everyone else.
# This directory is committed; one command per clone points git at it:
#
#     git config core.hooksPath .githooks
#
# To push past a failure — a known-broken dependency advisory, a red test you
# are pushing deliberately — use git's own escape hatch:
#
#     git push --no-verify
#
set -uo pipefail

# Nothing to check when the push deletes a ref and pushes no commits.
if [ -t 0 ]; then :; else
  saw_commit=0
  while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] || saw_commit=1
  done
  [ "$saw_commit" -eq 0 ] && exit 0
fi

echo "pre-push: running the checks CI will run (git push --no-verify to skip)"
exec "$(git rev-parse --show-toplevel)/scripts/verify.sh"
